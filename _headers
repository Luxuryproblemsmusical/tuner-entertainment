# Netlify headers

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Long-lived cache for artwork. If a file's content changes, rename it
# (e.g. lp-logo-framed-v2.webp) so visitors don't see a stale copy.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Icons and share image change rarely; a day of caching is plenty.
/favicon.svg
  Cache-Control: public, max-age=86400
/favicon-32.png
  Cache-Control: public, max-age=86400
/favicon.ico
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/og-image.png
  Cache-Control: public, max-age=86400
